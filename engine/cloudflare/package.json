{
  "name": "decentralised-governance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-amending decentralised governance engine (Cloudflare reference implementation)",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute REPLACE_WITH_YOUR_DB_NAME --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute REPLACE_WITH_YOUR_DB_NAME --local --file=schema.sql",
    "db:seed": "wrangler d1 execute REPLACE_WITH_YOUR_DB_NAME --remote --file=seed-proposals.sql"
  },
  "devDependencies": {
    "wrangler": "^4.16.1"
  }
}
